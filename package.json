{
  "name": "@tgtone/notifications-sdk",
  "version": "1.0.1",
  "description": "SDK para el sistema de notificaciones de TGT One — crear, listar, marcar como leídas y eliminar notificaciones desde cualquier app del ecosistema",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/useNotifications.d.ts",
      "default": "./dist/react/useNotifications.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "tgtone",
    "notifications",
    "sdk",
    "typescript"
  ],
  "author": "TGT Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tgt-technology/tgtone-notifications-sdk.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^5.9.3"
  }
}
